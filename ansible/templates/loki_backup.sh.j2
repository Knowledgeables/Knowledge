#!/bin/bash
set -euo pipefail
umask 077
DATE=$(date +%Y%m%d)
BACKUP_DIR="/opt/loki_backups"
BACKUP_FILE="$BACKUP_DIR/loki-backup-$DATE.tar.gz"
LOG_FILE="$BACKUP_DIR/loki_backup.log"
AZURE_BASE_URL="https://whoknowsdbbackup.blob.core.windows.net/loki-backups"
SAS_LOKI_TOKEN="{{ loki_sas_token }}"

mkdir -p "$BACKUP_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1
trap 'echo "BACKUP_FAILED ts=$(date -Is)"' ERR

echo "BACKUP_START ts=$(date -Is)"

echo "Compressing chunks and index inside container"
docker exec loki tar -czf /tmp/loki-backup.tar.gz /loki/chunks /loki/index 2>/dev/null

echo "Copying tarball to host"
docker cp loki:/tmp/loki-backup.tar.gz "$BACKUP_FILE"

UPLOAD_URL="${AZURE_BASE_URL}/$(basename "$BACKUP_FILE")?${SAS_LOKI_TOKEN}"
echo "Uploading to Azure"
for i in 1 2 3; do
  if azcopy copy "$BACKUP_FILE" "$UPLOAD_URL"; then
    echo "Upload success"
    break
  else
    echo "Upload failed (attempt $i)"
    sleep 5
  fi
  if [ "$i" -eq 3 ]; then
    echo "Upload failed after retries"
    exit 1
  fi
done

echo "Cleanup"
rm -f "$BACKUP_FILE"
docker exec loki rm -f /tmp/loki-backup.tar.gz

echo "Cleaning old local backups"
find "$BACKUP_DIR" -type f -name "loki-backup-*.tar.gz" -mtime +3 -delete

echo "BACKUP_SUCCESS ts=$(date -Is) file=$(basename "$BACKUP_FILE")"